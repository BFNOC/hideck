#!/bin/sh
set -eu

report_error() {
  printf '%s\n' "$1" >&2
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE"; fi
}

status() {
  # Listing distinguishes an absent container from a Docker permission/daemon error.
  if ! container_id=$(docker container ls -a --filter 'name=^/hideck-fnos$' --format '{{.ID}}'); then
    report_error '不能查询 Docker，请检查飞牛 Docker 服务及应用执行权限。'
    return 1
  fi
  [ -n "$container_id" ] || return 3
  format='{{index .Config.Labels "com.docker.compose.project"}}|{{index .Config.Labels "com.docker.compose.service"}}|{{.State.Status}}'
  if ! state=$(docker inspect --type container --format "$format" "$container_id"); then
    report_error '不能读取 HiDeck 容器状态。'
    return 1
  fi
  case "$state" in
    # fnOS status means running, not ready. Docker health remains a separate signal;
    # waiting for its first scheduled probe here would reject normal cold starts.
    'hideck-fnos|hideck|running') return 0 ;;
    hideck-fnos\|hideck\|*) return 3 ;;
    *) report_error '同名容器不属于此飞牛应用，请检查容器冲突。'; return 1 ;;
  esac
}

case "${1:-}" in
  start)
    # fnOS starts the declared Docker project; only initialize our own files here.
    exec "${TRIM_APPDEST:?fnOS application directory is required}/bin/initialize"
    ;;
  stop)
    # fnOS stops the declared Docker project. Do not stop other HiDeck deployments.
    exit 0
    ;;
  status) status ;;
  *) report_error '不支持的 HiDeck 生命周期操作。'; exit 1 ;;
esac
