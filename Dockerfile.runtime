# 运行时底包：录音库和证书只在这里装一次。发版镜像只 COPY 已经打好的二进制。
FROM alpine:3.24
WORKDIR /app

# ca-certificates / tzdata：HTTPS 和时区
# opencore-amr / vo-amrwbenc：AMR / AMR-WB
# lame-libs：MP3 录音
# psmisc：fuser，释放串口
# gcompat：UPX 压缩后的 Go 二进制在 musl 上需要
# libqmi：/usr/libexec/qmi-proxy，容器里走 QMI Proxy 模式需要
RUN apk add --no-cache \
      ca-certificates \
      gcompat \
      lame-libs \
      libqmi \
      opencore-amr \
      psmisc \
      tzdata \
      vo-amrwbenc && \
    test -e /usr/lib/libopencore-amrnb.so.0 && \
    test -e /usr/lib/libopencore-amrwb.so.0 && \
    test -e /usr/lib/libvo-amrwbenc.so.0 && \
    test -e /usr/lib/libmp3lame.so.0 && \
    test -x /usr/libexec/qmi-proxy && \
    rm -rf /usr/lib/girepository-1.0 \
      /usr/lib/libgirepository-2.0.so* \
      /usr/libexec/gio-launch-desktop \
      /usr/bin/gapplication \
      /usr/bin/gdbus \
      /usr/bin/gi-compile-repository \
      /usr/bin/gi-decompile-typelib \
      /usr/bin/gi-inspect-typelib \
      /usr/bin/gio \
      /usr/bin/gio-querymodules \
      /usr/bin/glib-compile-schemas \
      /usr/bin/gsettings && \
    cp -L /usr/share/zoneinfo/Asia/Shanghai /tmp/Shanghai && \
    cp -L /usr/share/zoneinfo/UTC /tmp/UTC && \
    rm -rf /usr/share/zoneinfo && \
    mkdir -p /usr/share/zoneinfo/Asia && \
    mv /tmp/Shanghai /usr/share/zoneinfo/Asia/Shanghai && \
    mv /tmp/UTC /usr/share/zoneinfo/UTC && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    mkdir -p /app/config /app/data /app/logs

EXPOSE 7575/tcp 7576/tcp 7580/udp
ENV CONFIG_PATH=/app/config/config.yaml
ENV TZ=Asia/Shanghai
